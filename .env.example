# For local development, run: python setup_local.py
# For manual configuration, copy this file to .env and set SECRET_KEY below.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
PYTHONANYWHERE_PROXY=0
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Read EMAIL_SETUP.md. Keep real keys only in your private .env file.
BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=MembersArea
